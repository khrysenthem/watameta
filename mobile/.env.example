# Google's iOS OAuth client id (from the same client whose ID goes into the
# API's AUTH_GOOGLE_MOBILE_CLIENT_ID — see the root .env.example and
# mobile/README.md). Not a secret; Expo inlines EXPO_PUBLIC_* into the bundle.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Where the API is reachable. Defaults to a hardcoded LAN IP in
# src/lib/config.ts if unset — override here if that doesn't match your
# machine (`ipconfig getifaddr en0` on macOS).
EXPO_PUBLIC_API_BASE_URL=

# Dev-only: pins /api/today's "now" to a fixed instant (passed through as
# ?now=) so testing against fixed/seeded data doesn't always look entirely
# forecasted once enough real time has passed since it was recorded. Leave
# unset for normal use.
EXPO_PUBLIC_DEBUG_NOW=
